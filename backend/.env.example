# backend/.env — copy to .env and fill secrets.
# The backend loads THIS file (backend/.env), not the repo-root .env.
#
# DB per environment:
#   DEV  -> onchain-tools-dev  (ref zcvubfadvdwjxgodznxh)
#   PROD -> onchain-tools      (ref vmlxyqzjdaegkfylxfka)

# OCT deployment mode: hosted (multi-tenant) or local (single-user)
OCT_MODE=hosted
PORT=3001
# Comma-separated allowed CORS/WS origins. In production include your Vercel URL,
# e.g. ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
#
# REQUIRED in hosted mode for the Sniper tab. The /api CORS layer goes permissive
# when this is unset, but /sniper/v1 fails CLOSED — it spends money, so it never
# inherits a wildcard. Leave it unset there and the Sniper tab renders empty.
# In LOCAL mode it is optional and only needed for a console served from
# somewhere other than this server or the vite dev port.
ALLOWED_ORIGINS=http://localhost:5173

# DEV:
#   SUPABASE_URL=https://zcvubfadvdwjxgodznxh.supabase.co
# PROD:
#   SUPABASE_URL=https://vmlxyqzjdaegkfylxfka.supabase.co
# NOTE: the app reads SUPABASE_SERVICE_KEY (SUPABASE_SERVICE_ROLE_KEY also accepted).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 64-char hex (32 bytes). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: if this changes, previously-encrypted Discord tokens can't be decrypted.
# Use a DISTINCT key per environment.
TOKEN_ENCRYPTION_KEY=

# --- FOMO (fomo.family) integration ---
# Shared service-account credentials. Bootstrap options (pick one):
#   1. One-time SQL seed (recommended for prod):
#        update public.fomo_poll_state set refresh_token = 'ap1wp_...' where id = true;
#      After first boot the poller reads DB-first and auto-rotates into fomo_poll_state.
#   2. Set FOMO_REFRESH_TOKEN here for first boot only, then remove once DB has a token.
#
# How to obtain FOMO_REFRESH_TOKEN (one-time, from a logged-in fomo.family session):
#   1. Open https://fomo.family in Chrome, sign in (Apple/Google via Privy).
#   2. DevTools → Application → Cookies → https://fomo.family
#   3. Copy the `privy-refresh-token` cookie value (starts with ap1wp_…).
#   4. Paste below OR seed into fomo_poll_state (option 1). Never commit real tokens.
#
# Local Playwright setup (required for API calls):
#   cd backend && npx playwright install chromium
#
# Railway: nixpacks.toml installs Chromium + OS libs at build time (local Playwright mode).
# When using the VPS worker instead, set FOMO_PROXY_URL + FOMO_WORKER_SECRET on Railway
# and you can skip Playwright on Railway (see fomo-worker/README.md).
#
# --- FOMO VPS worker (Phase 2 — recommended for prod) ---
# Point Railway at your always-on Chromium worker. When set, backend never launches Playwright.
# FOMO_PROXY_URL=http://167.179.66.57:3100
# FOMO_WORKER_SECRET=   # shared secret — must match the worker's FOMO_WORKER_SECRET
# FOMO_POLL_IDLE_INTERVAL_MS=60000
# FOMO_USER_ACTIVITY_LIMIT=15
# FOMO_LEADERBOARD_CACHE_MS=300000
# FOMO_HODLERS_CACHE_MS=900000
#   FOMO_POLL_INTERVAL_MS=10000   — fan-out poller interval (default 10s)
#
# The rest of the FOMO_* vars improve Cloudflare cold-start reliability (optional).
FOMO_REFRESH_TOKEN=
FOMO_POLL_INTERVAL_MS=
FOMO_PRIVY_APP_ID=
FOMO_PRIVY_CLIENT=
FOMO_PRIVY_CLIENT_ID=
FOMO_PRIVY_CA_ID=
FOMO_PRIVY_TOKEN=
FOMO_PRIVY_SESSION=
FOMO_CF_CLEARANCE=
FOMO_CF_BM=
FOMO_CF_UVID=

# --- OCT Discord bot (see docs/architecture/discord-bot.md) ---
# The bot runs IN-PROCESS with this backend. Unset DISCORD_BOT_TOKEN => bot disabled
# (the backend runs exactly as before).
#   1. Create an app at https://discord.com/developers/applications
#   2. Bot tab -> reset/copy the token; General Information -> copy the Application ID
#   3. Register slash commands:  npm run bot:deploy -w backend
#      (deploys to DISCORD_DEV_GUILD_ID instantly when set; add -- --global for global)
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
# Optional: a test server id for instant command deploys during development.
DISCORD_DEV_GUILD_ID=
# Channel POST /api/v1/bot/announce posts update announcements to (see
# `npm run bot:announce`). Unset => that endpoint returns 503 instead of guessing
# a channel. The bot needs View Channel + Send Messages + Embed Links there.
DISCORD_ANNOUNCE_CHANNEL_ID=

# Shared machine secret for the /api/v1/bot HTTP surface (external consumers only —
# the in-process bot calls the service layer directly). Unset => that API returns 503.
# Generate: node -e "console.log('oct_bot_' + require('crypto').randomBytes(24).toString('hex'))"
OCT_BOT_API_KEY=

# --- OCT Telegram bot (backend/src/tgbot/) ---
# A @BotFather bot that delivers OCT alerts into a Telegram GROUP with no
# credential handover: the user never connects their own Telegram account. This
# is the Bot API and is completely separate from the MTProto ingestion client in
# backend/src/telegram/ (which does read a user's own chats, via a session
# string). Unset TELEGRAM_BOT_TOKEN => the bot is disabled and the backend runs
# exactly as before.
#
# Setup, in @BotFather:
#   1. /newbot        -> name + username; copy the token into TELEGRAM_BOT_TOKEN
#   2. /setprivacy    -> select the bot -> ENABLE (privacy mode ON). OCT only
#      answers slash commands, and privacy mode still delivers every one of them
#      to the bot. Leaving it OFF would hand the bot every message in the group
#      for no benefit at all.
#   3. /setcommands   -> paste the list printed by commandListForBotFather()
#      in backend/src/tgbot/commands/index.ts (autocomplete only — Telegram has
#      no command registry to deploy to, unlike Discord).
#   4. Add the bot to the group, then run /start there.
# The bot needs no admin rights in the group; it only sends messages.
TELEGRAM_BOT_TOKEN=
#
# Comma-separated chat ids the bot will serve. SET THIS IN PRODUCTION — unset,
# the bot serves any chat that runs /start, and anyone who finds the username
# can add it. Group ids are negative (supergroups are -100…); read the id from
# the [TgBot] logs after running /start, or from any Telegram id bot.
# TG_BOT_ALLOWED_CHAT_IDS=-1001234567890
#
# Whose OCT alerts flow into these chats. Alerts are per-OCT-user and a group
# chat is not an OCT user, so hosted mode needs this named explicitly — set it
# to the auth.users UUID of the account whose feed should drive the chats.
# Unset in hosted mode = chats get commands but NO alerts (fail-closed, and
# /status says so). In local mode it defaults to the single 'local' user, so
# nothing needs setting there.
# A future per-chat linking flow will write tg_bot_chats.source_user_id, which
# overrides this per chat.
# TG_BOT_ALERT_SOURCE_USER_ID=
#
# Hosted mode additionally needs the tg_bot_chats table — apply
# supabase/migrations/20260903120000_tg_bot_chats.sql BY HAND. Without it
# /start reports that storage is unavailable; nothing else is affected.

# --- Birdeye portfolio (Portfolio tab ONLY — stats, PnL, holdings, activity) ---
# Required for /dashboard/portfolio. Get a key at https://bds.birdeye.so
# Standard (free) tier works but has rate limits (~5 req/s wallet APIs). Prefer one wallet over "All Wallets".
BIRDEYE_API_KEY=

# --- GMGN (missed-runner alerts + token enrichment ONLY — NOT used by Portfolio) ---
# Obtain from https://gmgn.ai/ai/generateapi
# Used for live MC in missed-runner alerts and Robinhood token snapshots. DexScreener is the fallback.
GMGN_API_KEY=

# --- pump.fun callouts (coin-communities.xyz) ---
# Shared app key for the pump.fun "callouts" read API (traders' calls/replies/
# positions on tokens). Authorizes the reads; treat it as a credential and never
# commit a real value. Unset = the /api/pumpfun/* routes return a clean 503 and
# the server still boots (the module self-gates on this key).
# Dual-brand fallbacks OCT_PUMPFUN_API_KEY / TRENCHCORD_PUMPFUN_API_KEY are also read.
PUMPFUN_API_KEY=
# The key has ONE rate-limit budget shared by every reader, so keyed reads are
# capped in-flight and retried on a transient failure (429/5xx/timeout). Both are
# tunable without a redeploy; dual-brand OCT_/TRENCHCORD_ fallbacks are read too.
# PUMPFUN_MAX_CONCURRENT=2   # max simultaneous coin-communities requests
# PUMPFUN_READ_RETRIES=2     # extra attempts after the first; 0 disables retry
# Optional cache TTL overrides (ms); sensible defaults ship in cache.ts:
# PUMPFUN_TOKEN_CALLOUTS_CACHE_MS=300000
# PUMPFUN_WALLET_CALLOUTS_CACHE_MS=120000
# PUMPFUN_TOP_CACHE_MS=300000
# PUMPFUN_TRENDING_CACHE_MS=300000

# --- pump.fun callouts -> public Discord channel (default OFF) ---
# Reposts tracked pump.fun callouts into a Discord channel via the in-process bot
# (no webhook, no second login). This is a PUBLIC post, so it is opt-in: both vars
# below must be set or the feature no-ops silently.
# Dual-brand fallbacks TRENCHCORD_CALLOUT_DISCORD_* are read for every var here.
OCT_CALLOUT_DISCORD_ENABLED=false
OCT_CALLOUT_DISCORD_CHANNEL_ID=
# Caller source. Unset => OCT's own global Top Callers board (built from the public
# pump.fun firehose). Set to a comma-separated list of caller WALLET addresses to
# post only those. Users' private follow lists are NEVER a source — publishing them
# would leak who-follows-whom.
# OCT_CALLOUT_DISCORD_CALLERS=
# Optional flood protection (per channel). Posts beyond the cap are dropped, counted
# in the logs, and summarised as "+N more callouts held back" on the next post.
# OCT_CALLOUT_DISCORD_MAX_PER_WINDOW=5
# OCT_CALLOUT_DISCORD_WINDOW_MS=60000
# Optional Top Callers board slice + how long it is cached.
# OCT_CALLOUT_DISCORD_TOP_LIMIT=25
# OCT_CALLOUT_DISCORD_MIN_CALLS=3
# OCT_CALLOUT_DISCORD_BOARD_WINDOW_MS=604800000
# OCT_CALLOUT_DISCORD_SOURCE_TTL_MS=600000

# --- pump.fun callouts -> per-user Discord DMs (no env needed to enable) ---
# Separate from the PUBLIC channel post above. Each user opts in for themselves in
# the console (Settings -> Discord Bot -> pump.fun callouts) and can mute any single
# caller on Pump.fun -> Following; there is no operator switch, so nothing here has
# to be set. Requires DISCORD_BOT_TOKEN (the same in-process bot) and the migration
# 20260816120000_pump_tracked_callers_notify_discord.sql.
# Most DMs one poll cycle may send before the overflow is dropped and logged. Kept
# well under the poll interval so a callout burst can never stall the poller, and
# low enough that Discord does not read a burst of DMs as spam.
# PUMP_CALLOUT_DM_MAX_PER_DISPATCH=12

# --- Missed-runner alerts (on-chain wallet balance checks) ---
# Solana balance checks via Helius (https://helius.dev). Required for SOL missed-runner alerts.
# Also required for the Trade Journal (own-wallet swap ingestion via the Helius
# Enhanced Transactions API) — without it the journal poller idles cleanly.
HELIUS_API_KEY=
# Optional: Alchemy key for EVM balanceOf on eth/bsc/base (falls back to public RPC if unset).
ALCHEMY_API_KEY=
# Optional: poller interval in ms (default 180000 = 3 min).
MISSED_RUNNER_POLL_INTERVAL_MS=

# --- Trade Journal (own-wallet swap ingestion + "meta dying" alerts) ---
# Requires HELIUS_API_KEY (above) for ingestion; the volume-death poller is
# keyless (DexScreener). Everything self-gates — unset values use defaults and
# the server boots clean with nothing configured.
# All vars also read TRENCHCORD_-prefixed fallbacks.
# Master switch (default on; set false/0/off to disable both journal pollers).
# OCT_JOURNAL_ENABLED=true
# Ingestion poll interval in ms (default 120000 = 2 min, floor 30000).
# OCT_JOURNAL_POLL_MS=120000
# History backfill cap for a freshly added wallet, in Helius pages of 100 txs
# (default 10 = 1000 txs).
# OCT_JOURNAL_BACKFILL_PAGES=10
# Volume-death poll interval in ms (default 180000 = 3 min, floor 60000).
# OCT_JOURNAL_VOLDEATH_POLL_MS=180000
# Collapse ratio: both m5-vs-h1 and h1-vs-h6 per-minute volume rates must sit
# below this to fire (default 0.35).
# OCT_JOURNAL_VOLDEATH_RATIO=0.35
# One alert per position per this window in ms (default 1800000 = 30 min).
# OCT_JOURNAL_VOLDEATH_COOLDOWN_MS=1800000
# Dust floor: skip the alert when the held position is worth less than this in
# USD — a ~$0 bag is not something you can act on (default 10; 0 disables).
# Positions with an UNKNOWN value (no DexScreener price) still alert.
# OCT_JOURNAL_VOLDEATH_MIN_POSITION_USD=10
#
# --- Abandoned-position auto-close (runs inside the volume-death sweep) ---
# A token that goes to zero in VALUE while you still hold the full token count
# never trips the 2% dust close, so it stays "open" forever. This closes those
# dead bags as a sale at ZERO PROCEEDS — the unrecovered cost becomes a real
# realized loss, which will lower your realized PnL by the cost of every dead
# bag the first time it runs. It uses the volume-death sweep's existing
# DexScreener response, so it costs no extra requests.
# Master switch (default on; set false/0/off to disable auto-closing).
# OCT_JOURNAL_ABANDON_ENABLED=true
# Minimum days with no trade on the position before it can be closed
# (default 7, measured from the position's last trade).
# OCT_JOURNAL_ABANDON_MIN_AGE_DAYS=7
# Position value strictly under this USD counts as unsellable (default 1).
# OCT_JOURNAL_ABANDON_MAX_VALUE_USD=1
# Pooled pair liquidity strictly under this USD counts as "no LP" (default
# 100). No DexScreener pair at all also qualifies.
# OCT_JOURNAL_ABANDON_MIN_LIQUIDITY_USD=100
# Never auto-closed: zero-cost positions, positions whose pair exists but
# returned no price this cycle, and any cycle where DexScreener failed —
# missing data abstains rather than booking a false loss.

# --- Price alerts (operator-set levels; backend/src/priceAlerts/) ---
# "Ping me if this token crosses 150K mcap." No detection, no scoring, no
# discovery — you name the token and the number, and the alert fires ONCE, on
# the crossing. Keyless upstream (DexScreener batch token endpoint) and fully
# self-gating: zero armed alerts means zero upstream requests.
# All vars also read TRENCHCORD_-prefixed fallbacks.
# Master switch (default on; set false/0/off to disable the poller).
# OCT_PRICE_ALERTS_ENABLED=true
# Poll interval in ms (default 25000 = 25s, floor 10000).
# OCT_PRICE_ALERT_POLL_MS=25000
# Mints per DexScreener request (default 10, max 30). The endpoint documents a
# 30-ADDRESS limit but caps the RESPONSE at 30 PAIRS, so a large batch can
# silently drop tokens; small batches keep the halving retry rare. At the
# defaults a 50-token watchlist costs ~12 req/min against a ~300/min ceiling.
# OCT_PRICE_ALERT_BATCH_SIZE=10
#
# Hosted mode additionally needs the price_alerts table — apply
# supabase/migrations/20260814120000_price_alerts.sql BY HAND. Without it the
# backend warns once and price alerts idle; nothing else is affected.

# --- EVM sniper: Robinhood Chain (backend/src/sniper/evm/, executors/evmUniswap.ts) ---
#
# Buys an EVM token on Robinhood Chain (chainId 4663) when ONE allowlisted
# Telegram channel posts its contract address. Non-custodial: OCT signs with the
# key below. Everything here is OFF by default — with none of these set the
# server boots identically and there is no listener on the Telegram emitter at
# all.
#
# LOCAL MODE ONLY. A process-wide signing key cannot be scoped to one tenant, so
# in hosted mode the trigger refuses to arm and says so once at startup.
#
# ORDER OF OPERATIONS: set the trigger + caps FIRST and leave the key unset. The
# module then runs the whole path — pool discovery, best-execution routing, and
# both pre-trade gates — and refuses at the signature with `no_credential`. That
# is a rehearsal of the real path, not a different one. Add the key last.

# THE TRIGGER. Comma-separated Telegram chat ids, Bot-API form (e.g.
# -1001234567890 for a channel/supergroup — the same format as
# TG_BOT_ALLOWED_CHAT_IDS). FAILS CLOSED: unset or empty means NOTHING fires.
# Malformed entries are dropped with a warning, never treated as a wildcard.
# SNIPER_EVM_TRIGGER_CHAT_IDS=-1001234567890

# THE SIGNING KEY. 32-byte hex, 0x-prefixed. Read inside the executor's fire
# call frame only — never at import, never logged, never returned by any
# endpoint, never written to Supabase Vault. Absent => the sniper refuses to
# fire and says so; it does NOT crash the server.
# SNIPER_EVM_PRIVATE_KEY=0x...

# SIZE AND THE GOVERNING CAP.
# Per fire, in ETH. Default 0.01. Hard ceiling 0.1 — a larger value is clamped.
# SNIPER_EVM_BUY_ETH=0.01
# Per UTC day, in ETH, across every fire. Default 0.1. Hard ceiling 1.0.
#
# THIS IS THE CONTROL THAT MATTERS. The source channel scans on the order of 234
# tokens/24h, so without it the module would attempt ~2.34 ETH/day. It is
# enforced by the same atomic budget reservation the rest of the sniper uses
# (sniper_budget / reserveLeg), so it resets at the UTC boundary and cannot be
# routed around by a retry. A missing or unparseable value uses the default —
# never unlimited. A value below one fire is raised to exactly one fire, so a
# typo reads as a small cap rather than as a broken module.
# SNIPER_EVM_DAILY_CAP_ETH=0.1

# EXECUTION.
# Slippage tolerance in basis points (1-10000). Default 500 = 5%.
# SNIPER_EVM_SLIPPAGE_BPS=500
# Swap deadline, seconds from submission (5-3600). Default 120.
# SNIPER_EVM_DEADLINE_SECONDS=120
# RPC endpoint. Default https://rpc.mainnet.chain.robinhood.com. Must be http(s).
# SNIPER_EVM_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# PRE-TRADE GATES. Both DEFAULT ON. These are execution correctness, not policy:
# a pool too thin to exit is a failed trade, and an unsellable token is not a
# position. Set to false/0/off to disable one deliberately; an unrecognised
# value leaves the gate ON.
#
# Minimum quoted USD liquidity in the pool being routed to. Default 5000.
# (A real token on this chain had $32 of liquidity behind a $45K "market cap".)
# SNIPER_EVM_MIN_LIQUIDITY_USD=5000
# SNIPER_EVM_LIQUIDITY_GATE=true
#
# Sell simulation: before buying, eth_simulateV1 runs buy -> approve -> sell in
# one block and the buy is aborted unless the round trip returns at least
# SNIPER_EVM_MIN_ROUNDTRIP_BPS of the ETH put in. Default 5000 = 50%, which is
# sized to catch honeypots and punitive taxes rather than to second-guess
# ordinary tokens (a healthy round trip through a 1% pool returns ~98%).
# Needs NO private key — it simulates from a synthetic funded address.
# SNIPER_EVM_MIN_ROUNDTRIP_BPS=5000
# SNIPER_EVM_SELL_SIM_GATE=true

# OPTIONAL SAFETY DECLARATION. The wallet you funded and capped. When set, the
# executor refuses to fire if SNIPER_EVM_PRIVATE_KEY derives any other address —
# which is what stops a rotated key from spending from a wallet nobody sized.
# SNIPER_EVM_WALLET_ADDRESS=0x...

# Note: OCT_SNIPER_DRY_RUN=true still overrides everything above, process-wide,
# swapping only the final network hop while idempotency, the caps and the retry
# loop all run for real.
