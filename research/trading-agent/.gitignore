# Python / uv artifacts for the trading-agent research package.
# (src/ is tracked; build + cache + data outputs are not.)
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.uv/
uv.lock

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Substreams package + any downloaded/derived data (never commit the tape).
# Anchored to the package-root output dir so it does NOT swallow the `data/` SOURCE module
# (src/oct_trading_agent/data/) or the data-layer tests (tests/data/).
/data/
*.spkg
