# FOMO worker — always-on Chromium gateway for prod-api.fomo.family
PORT=3100
# Bind publicly only when Railway (or your backend) can reach this host.
HOST=0.0.0.0

# Shared secret — must match FOMO_WORKER_SECRET on the OCT backend.
FOMO_WORKER_SECRET=

# Persistent Chromium profile (survives restarts; keeps CF cookies warm).
FOMO_PROFILE_DIR=/var/lib/fomo-worker/profile

# Bootstrap Privy refresh token (one-time). After first boot, prefer Supabase fomo_poll_state.
FOMO_REFRESH_TOKEN=

# Optional: read/write rotated refresh tokens (recommended — same as OCT backend prod).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional Cloudflare cold-start cookies from a logged-in fomo.family session.
FOMO_PRIVY_APP_ID=
FOMO_PRIVY_CLIENT=
FOMO_PRIVY_CLIENT_ID=
FOMO_PRIVY_CA_ID=
FOMO_PRIVY_TOKEN=
FOMO_PRIVY_SESSION=
FOMO_CF_CLEARANCE=
FOMO_CF_BM=
FOMO_CF_UVID=

DEBUG=false
