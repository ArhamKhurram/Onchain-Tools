{
  // The workspace tsconfig has `rootDir: src` and only includes `src/**/*`, so
  // it deliberately does not see this directory — `scripts/` is tooling, not
  // part of the shipped build, and must never end up in `dist/`.
  //
  // This config exists so the scripts still get the same `strict: true`
  // treatment:  npx tsc --noEmit -p scripts
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "rootDir": "..",
    "allowImportingTsExtensions": false
  },
  "include": ["**/*.ts", "../src/**/*.ts"]
}
