{
  "name": "oct-lp-automation",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "typecheck:scripts": "tsc --noEmit -p scripts",
    "test": "vitest run",
    "test:watch": "vitest",

    "new:operator": "tsx scripts/newOperator.ts",
    "preflight": "tsx scripts/preflight.ts",
    "deploy:module": "tsx scripts/deployModule.ts",
    "tx:enable": "tsx scripts/enableModule.ts",
    "tx:allowlist": "tsx scripts/seedAllowlist.ts",
    "verify:setup": "tsx scripts/verifySetup.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "dotenv": "^17.3.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
