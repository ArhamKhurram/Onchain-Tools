# lp-automation — environment
#
# This process holds a signing key over real funds. It has NO inbound network
# surface: it makes outbound calls only (Krystal REST + chain RPC + Supabase
# reads). Do not add an HTTP listener to it.

# --- Chain -----------------------------------------------------------------
# Phase 1 targets Robinhood Chain (id 4663). See LP_AUTOMATION_PLAN.md §1.
LP_CHAIN=robinhood

# Robinhood's docs name Alchemy and QuickNode as providers; both have free tiers.
# The WS URL is what makes sub-second range-exit detection possible — without it
# the watcher degrades to polling and says so loudly (see src/ingest/rpc/).
LP_RPC_URL=
LP_RPC_WS_URL=

# Optional watcher tuning. Defaults are sized off Robinhood Chain's advertised
# ~100ms block time (unverified — see LP_AUTOMATION_PLAN.md §11).
#
# LP_RPC_MODE=auto        # auto | websocket | polling. `websocket` disables the
#                         # polling fallback, so a dead socket stays loudly dead
#                         # instead of silently degrading to a slower mode.
# LP_RPC_CONFIRMATIONS=3  # Blocks before a range crossing is treated as confirmed.
#                         # 0 disables reorg protection entirely.
# LP_RPC_STALENESS_MS=10000     # No block seen for this long => positions are NOT
#                               # being watched; fires a loud callback.
# LP_RPC_POLL_INTERVAL_MS=1000  # slot0() poll cadence in degraded/polling mode.
# LP_RPC_MAX_WS_ATTEMPTS=5      # Reconnect attempts before falling back to polling.

# --- The arm gate ----------------------------------------------------------
# Whether this process may BROADCAST transactions. Defaults to disarmed.
#
# Only the exact string `true` arms it. `1`, `yes`, `TRUE`, `True`, and any
# value with surrounding whitespace all stay DISARMED — deliberately strict, so
# an ambiguous value can never be read as consent to spend money.
#
# Disarmed is not a stub: the process still watches, evaluates, builds calldata,
# simulates every transaction and writes the full audit log. The broadcast is
# the single step skipped. Run disarmed first and read the audit log to see
# exactly what it WOULD have done.
#
# Deploying and arming are two separate decisions on purpose.
LP_ARMED=false

# --- Safe + automation module (LP_AUTOMATION_PLAN.md §4) -------------------
# The Safe that holds the funds. Its owner key is YOURS and stays offline —
# it is not used for day-to-day automation, only to change the module's bounds.
LP_SAFE_ADDRESS=

# The deployed OctAutomationModule, enabled on the Safe above.
LP_MODULE_ADDRESS=

# Block the module was deployed at, printed by `npm run deploy:module`.
# `npm run verify:setup` replays allowlist events from here to detect anything
# authorized that shouldn't be — a compromise looks exactly like a working
# setup unless you check the history, not just the current state.
LP_MODULE_DEPLOY_BLOCK=

# The operator's ADDRESS (not its key). Read-only scripts use this to verify
# authorization without ever touching a private key.
LP_OPERATOR_ADDRESS=

# Used ONLY by `npm run deploy:module`, and only on the machine doing the
# deploy. The deployer gets no privileges over the module — `safe` is the sole
# admin — so this can be a throwaway key with just enough gas.
LP_DEPLOYER_PRIVATE_KEY=

# The automation hot key — the module's authorized operator.
#
# MUST be a freshly generated wallet. Never reuse a wallet holding unrelated
# funds. This key can only do what the module allows (allowlisted destination +
# selector, within per-tx and daily caps) and can NEVER widen those limits or
# touch the Safe directly — that is the entire point of the module design.
# Still: treat its compromise as "lose up to the daily cap", and size the cap
# accordingly.
LP_OPERATOR_PRIVATE_KEY=

# --- Krystal (calldata + pool data, no API key required) -------------------
KRYSTAL_API_BASE=https://api.krystal.app

# --- Policy source ---------------------------------------------------------
# The policy is authored in the OCT dashboard and only ever READ here — this
# process never writes it back (LP_AUTOMATION_PLAN.md §9 point 1).
#
# Set these to read the live policy the dashboard writes. If they are unset the
# process falls back to LP_POLICY_FILE, and failing that to DEFAULT_POLICY —
# which ships with an EMPTY allowlist, so it does nothing. That fallback chain
# is deliberate: a misconfigured policy source must degrade to inaction, never
# to acting on stale or invented limits.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Which OCT account's dashboard policy this worker follows. The policy table is
# per-user, so this is required whenever SUPABASE_* are set. Get it from your
# Supabase auth.users row.
LP_POLICY_USER_ID=

# Local JSON policy, used ONLY when Supabase is not configured. Supabase wins
# when both are present — otherwise a stale local file could silently override
# what you just saved in the dashboard.
# LP_POLICY_FILE=./data/policy.json

# --- Runtime tuning --------------------------------------------------------
# Append-only action log (LP_AUTOMATION_PLAN.md §10 step 6). On startup the
# process quarantines any position with an unresolved intent, so this file's
# continuity across restarts is load-bearing — put it on a persistent volume,
# not ephemeral container storage.
# LP_AUDIT_LOG_PATH=./data/audit.jsonl

# How often the slow lane refreshes policy, positions and fee accrual.
# Range-exit detection does NOT depend on this — that runs on the RPC watcher.
# LP_POSITION_POLL_INTERVAL_MS=60000

# Calldata built speculatively on an `observed` crossing is discarded if it is
# older than this when the crossing confirms. Krystal prices its swaps at build
# time; stale calldata means stale pricing.
# LP_CALLDATA_MAX_AGE_MS=30000

# Slippage as a FRACTION, not bps and not percent — 0.005 is 0.5%.
# Krystal accepts 0.5 as *fifty percent* (plan §3), hence the low ceiling.
# LP_SWAP_SLIPPAGE=0.005
# LP_LIQUIDITY_SLIPPAGE=0.005

# Per-transaction native value ceiling enforced off-chain, in wei. Defaults to
# 0 — fail closed. The on-chain module cap is the real boundary; this one just
# refuses earlier and cheaper.
# LP_MAX_TX_VALUE_WEI=0

# Estimated gas cost per action in USD. Unset means the fees-vs-gas compound
# arm cannot be evaluated and only the interval backstop fires — which is the
# correct behaviour, not a degraded one.
# LP_GAS_COST_USD=

# Krystal's DEX identifier. Verified as `uniswapv3` for chain 4663 (plan §3).
# LP_KRYSTAL_PLATFORM=uniswapv3
